flowchart LR
    %% =========================
    %% Clusters
    %% =========================

    subgraph TRAIN["Training path: mini GPT가 답변 생성 능력을 배우는 과정"]
        direction LR

        C0["1. 원문 corpus<br/>NSMC 리뷰 / 학습 텍스트"]:::data

        B0["2. BPETokenizer.train(corpus)<br/>src/bpe.py<br/>BPE vocab과 merge rule 학습"]:::tok
        B1["2-1. _init_special_tokens()<br/>&lt;pad&gt;, &lt;unk&gt;, &lt;bos&gt;, &lt;eos&gt;<br/>byte token 0~255 초기화"]:::tok
        B2["2-2. pair 빈도 계산<br/>가장 자주 붙는 token pair 찾기"]:::tok
        B3["2-3. merge rule 추가<br/>self.merges<br/>id_to_token / token_to_id 갱신"]:::tok

        E0["3. BPETokenizer.encode(text)<br/>문자열 -> token IDs"]:::tok

        D0["4. GPTDataset.__init__()<br/>긴 token ID 리스트를 window로 자름"]:::data
        D1["5. GPTDataset.__getitem__()<br/>input_ids / target_ids 생성<br/>(T), (T)"]:::data
        D2["6. create_dataloader()<br/>batch 생성<br/>(B, T), (B, T)"]:::data

        T0["7. train_model()<br/>src/train.py<br/>epoch 단위 학습 루프"]:::train
        T1["8. calc_loss_batch()<br/>input/target batch를 model에 전달"]:::train

        M0["9. GPTModel.forward(input_ids, targets)<br/>src/model.py"]:::model
        M1["10. InputEmbedding.forward()<br/>token embedding + position embedding<br/>(B,T) -> (B,T,C)"]:::model
        M2["11. TransformerBlock.forward() x N<br/>attention + FFN + residual"]:::model
        A0["12. MultiHeadAttention.forward()<br/>causal mask로 미래 token 차단"]:::model
        F0["13. FeedForward.forward()<br/>각 token 위치별 MLP 처리"]:::model
        M3["14. lm_head<br/>hidden -> vocab logits<br/>(B,T,C) -> (B,T,V)"]:::model

        L0{"15. targets 있음?"}:::decision
        L1["16. cross entropy loss<br/>logits와 target 비교"]:::train
        O0["17. optimizer.step()<br/>파라미터 업데이트"]:::train
        CK["18. save_checkpoint()<br/>학습된 모델 저장"]:::store
    end

    subgraph INFER["Inference path: 사용자가 질문했을 때 답변을 생성하는 과정"]
        direction LR

        U0["19. 사용자 질문<br/>start_context"]:::user
        I0["20. BPETokenizer.encode(start_context)<br/>질문 문자열 -> token IDs"]:::tok
        G0["21. generate()<br/>src/train.py<br/>max_new_tokens만큼 반복"]:::infer
        G1["22. context cropping<br/>최근 context_size token만 사용"]:::infer
        IM["23. GPTModel.forward(idx)<br/>targets 없이 logits만 반환"]:::model
        G2["24. 마지막 위치 logits 선택<br/>logits[:, -1, :]"]:::infer
        G3{"25. sampling 방식"}:::decision
        G4["26-A. greedy<br/>argmax로 next token 선택"]:::infer
        G5["26-B. temperature / top-k<br/>확률적으로 next token 선택"]:::infer
        G6["27. next_id append<br/>idx 뒤에 새 token 붙임"]:::infer
        STOP{"28. eos_id 생성<br/>또는 길이 제한 도달?"}:::decision
        DEC["29. BPETokenizer.decode(ids)<br/>token IDs -> UTF-8 문자열"]:::tok
        ANS["30. 생성된 답변 텍스트"]:::user
    end

    %% =========================
    %% Training edges
    %% =========================

    C0 --> B0
    B0 --> B1
    B1 --> B2
    B2 --> B3
    B3 --> E0

    E0 --> D0
    D0 --> D1
    D1 --> D2
    D2 --> T0
    T0 --> T1
    T1 --> M0

    M0 --> M1
    M1 --> M2
    M2 --> A0
    A0 --> F0
    F0 --> M3
    M3 --> L0
    L0 -- "yes" --> L1
    L1 --> O0
    O0 --> T0
    T0 --> CK

    %% =========================
    %% Inference edges
    %% =========================

    CK --> U0
    U0 --> I0
    I0 --> G0
    G0 --> G1
    G1 --> IM
    IM --> G2
    G2 --> G3
    G3 -- "greedy" --> G4
    G3 -- "sample" --> G5
    G4 --> G6
    G5 --> G6
    G6 --> STOP
    STOP -- "no" --> G1
    STOP -- "yes" --> DEC
    DEC --> ANS

    %% =========================
    %% Styles
    %% =========================

    classDef user fill:#EEF6FF,stroke:#2563EB,stroke-width:1.4px,color:#0F172A;
    classDef tok fill:#F7FEE7,stroke:#65A30D,stroke-width:1.4px,color:#0F172A;
    classDef data fill:#FFF7ED,stroke:#EA580C,stroke-width:1.4px,color:#0F172A;
    classDef model fill:#F5F3FF,stroke:#7C3AED,stroke-width:1.4px,color:#0F172A;
    classDef train fill:#ECFDF5,stroke:#059669,stroke-width:1.4px,color:#0F172A;
    classDef infer fill:#EFF6FF,stroke:#0284C7,stroke-width:1.4px,color:#0F172A;
    classDef store fill:#FEFCE8,stroke:#CA8A04,stroke-width:1.4px,color:#0F172A;
    classDef decision fill:#FEF2F2,stroke:#DC2626,stroke-width:1.4px,color:#0F172A;
